# Paddle.js frontend configuration. Client-side tokens and Price IDs are public;
# never put the server-side PADDLE_API_KEY or webhook secret in VITE_* variables.
VITE_PADDLE_ENVIRONMENT=production
VITE_PADDLE_CLIENT_TOKEN=live_replace_me
VITE_PADDLE_MONTHLY_PRICE_ID=pri_replace_me
VITE_PADDLE_QUARTERLY_PRICE_ID=pri_replace_me
VITE_PADDLE_ANNUAL_PRICE_ID=pri_replace_me
