{
  "name": "nosub",
  "version": "0.3.3",
  "private": true,
  "description": "YouTube listening practice — repeat sentences, reveal captions, slow down, and look up words.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "billing:dev": "pnpm --dir billing-site dev",
    "billing:build": "pnpm --dir billing-site build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "zip": "npm run build && cd dist && powershell Compress-Archive -Path * -DestinationPath ../nosub.zip -Force"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^9.16.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "globals": "^15.14.0",
    "happy-dom": "^20.11.1",
    "supabase": "^2.111.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
